# Local single-user prototype defaults.
# Keep demonstration records disabled when working with program data.
AUTH_MODE="local-single-user"
DEMO_ENABLED="false"
WORKSPACE_TRANSFER_MODE="local"
STEWARD_USER_IDS=""

# Optional GenAI.mil decision support is configured once with
# npm run local:genai:configure. It stores the endpoint, model, and API key in
# ACL-protected .a2o-secrets storage, outside Git. The app sends a request only
# after an operator presses "Ask GenAI.mil" from a grounded record page.
# If your AWS Workspace proxy uses an approved private CA, enroll it once with
# npm run local:certificate:trust. Never set NODE_TLS_REJECT_UNAUTHORIZED=0.
# For a development workspace only, npm run local:genai:tls-bypass starts a
# loopback-only curl transport that bypasses certificate and revocation checks
# solely for an explicit GenAI.mil request. Restore verification with
# npm run local:genai:tls-verify before using an accredited environment.
