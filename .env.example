# Local single-user prototype defaults.
# Keep demonstration records disabled when working with program data.
AUTH_MODE="local-single-user"
DEMO_ENABLED="false"
WORKSPACE_TRANSFER_MODE="local"
STEWARD_USER_IDS=""

# Optional GenAI.mil decision-support assistant. This is disabled until all
# three values are configured. The API key stays in this local environment and
# is never returned to the browser. The application sends a request only after
# an operator presses "Ask GenAI.mil" from a grounded record page.
# GENAI_MIL_API_URL="https://<approved-genai-mil-endpoint>/chat/completions"
# GENAI_MIL_MODEL="<approved-model-id>"
# GENAI_MIL_API_KEY=""
# If your AWS Workspace proxy uses an approved private CA, trust that CA with
# NODE_EXTRA_CA_CERTS="C:\\path\\to\\approved-workspace-ca.pem". Never set
# NODE_TLS_REJECT_UNAUTHORIZED=0.
