{
  "name": "a2o-technical-baseline-manager",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "local:init": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/Initialize-A2OWorkspace.ps1",
    "local:init:clean": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/Initialize-A2OWorkspace.ps1 -Install",
    "local:start": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/Start-A2OWorkspace.ps1",
    "local:backup": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/Backup-A2OWorkspace.ps1",
    "local:restore": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/Restore-A2OWorkspace.ps1",
    "local:network-check": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/Test-A2ONetworkBoundary.ps1",
    "local:verify": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/Test-A2OWorkspace.ps1",
    "local:verify:fast": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/Test-A2OWorkspace.ps1 -SkipBuild",
    "local:purge-objectives": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/Remove-ImportedObjectives.ps1"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "drizzle-orm": "0.45.2",
    "jszip": "3.10.1",
    "jspdf": "^4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.7",
    "vite": "8.2.1",
    "wrangler": "4.124.0"
  },
  "type": "module"
}
